<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      只留 app_name（AndroidManifest 的 android:label 用得到）。

      其餘 18 條在程式裡是零引用的死條目，而且已經與實際顯示的文案分歧：
      這裡寫「網路連線失敗，請檢查網路設定」，畫面上其實顯示別的句子。
      留著只會讓人改錯地方——以為改了文案，實際畫面完全沒變。
      共用文案改放 ui/UiText.kt，理由見該檔說明。
    -->
    <string name="app_name">Doply Hub</string>
</resources>
